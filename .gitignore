# =====================================================================
# Environment files — keep secrets & local overrides out of VCS
# =====================================================================
.env
.env.*
!.env.example

# =====================================================================
# Node.js / Frontend (Next.js 16)
# =====================================================================
Frontend/node_modules/
Frontend/.next/
Frontend/out/
Frontend/dist/
Frontend/build/
Frontend/.turbo/
Frontend/.cache/
Frontend/coverage/
Frontend/.env.local
Frontend/.eslintcache

# General Node tooling (covers stray root-level artifacts)
node_modules/
.next/
out/
build/
dist/
.cache/
coverage/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =====================================================================
# Go Backend
# =====================================================================
Backend/bin/
Backend/tmp/
Backend/uploads/
# database backup output (scripts/backup.sh)
Backend/backups/
Backend/.env.local
Backend/.eslintcache
Backend/*.test
Backend/*.out
Backend/*.prof
go-build-cache/

# =====================================================================
# Python tooling (optional scripts/helpers)
# =====================================================================
__pycache__/
*.py[cod]
.venv/
venv/

# =====================================================================
# OS / Editor / IDE
# =====================================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.iml
*.ipynb_checkpoints

# =====================================================================
# Docker
# =====================================================================
docker-compose.override.yml

# =====================================================================
# Secrets & runtime artifacts
# =====================================================================
*.pem
*.key
*.crt
*.cer
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
access.log*
error.log*

# =====================================================================
# Local uploads & generated media
# =====================================================================
uploads/
public/uploads/
media/
cache/

# =====================================================================
# Temp files & tooling caches
# =====================================================================
tmp/
temp/
*.tmp
.kilo/
.kilocode/
.Trash-*
.turbo
.pnpm-store
